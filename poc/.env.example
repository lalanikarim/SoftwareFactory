# Factory PoC environment (copy to poc-factory/.env; never commit .env)

# Local model endpoint (OpenAI-compatible, e.g. Unsloth on your inference host).
# Copy to poc/.env and set the real URL for your machine — never commit .env.
OPENAI_BASE_URL=http://<inference-host>:8888/v1
OPENAI_API_KEY=<key>

# GitHub access for host-side operations (issue fetch, push, PR create).
# Leave unset to use stored `gh` auth on this machine.
FACTORY_GITHUB_TOKEN=

# Per-repo config file (multi-repo plan §3.1). When set, it defines repo,
# sandbox image, test command, and budgets — and wins over the env fallbacks
# below. See poc/config/factory-fixture.json for the shape.
FACTORY_CONFIG=

# Legacy single-repo fallback (used only when FACTORY_CONFIG is unset).
# Fixture repo (owner/name) the factory implements issues in.
FIXTURES_REPO=lalanikarim/factory-fixture

# Git identity for worker commits (host-side, inside the workspace clone).
FACTORY_GIT_NAME=factory-worker
FACTORY_GIT_EMAIL=factory-worker@localhost

# Webhook secret for the intake adapter's X-Hub-Signature-256 verification.
# Per-repo by design: this factory serves FIXTURES_REPO, so this is THAT
# repo's webhook secret (set the same value in that repo's GitHub webhook
# config). REQUIRED when running `01-intake-g0.mjs serve --host 0.0.0.0`
# (or any non-loopback bind).
GITHUB_WEBHOOK_SECRET=
